<!DOCTYPE html>
<html>
<head>
    <title>Session Tracking Demo</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #eef2f7;
            margin: 0;
        }

        .container {
            width: 500px;
            margin: 70px auto;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        h1 {
            text-align: center;
            color: #1565c0;
        }

        .description {
            text-align: center;
            color: #666;
        }

        label {
            display: block;
            margin-top: 20px;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 16px;
        }

        input[type="submit"] {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: #1565c0;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        input[type="submit"]:hover {
            background-color: #0d47a1;
        }

        .info {
            margin-top: 25px;
            padding: 15px;
            background-color: #e3f2fd;
            border-radius: 5px;
            color: #1565c0;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Session Tracking</h1>

    <p class="description">
        Hidden Form Field and URL Rewriting Demonstration
    </p>

    <!-- Send form data to SessionTracking servlet -->
    <form action="SessionTracking" method="post">

        <label for="username">
            Enter Your Name
        </label>

        <input type="text"
               id="username"
               name="username"
               placeholder="Enter your name"
               required>

        <!-- Hidden Form Field -->
        <input type="hidden"
               name="trackingMethod"
               value="Hidden Form Field">

        <input type="submit"
               value="Submit">

    </form>

    <div class="info">

        <b>Techniques Demonstrated:</b>

        <ul>
            <li>HTTP Session</li>
            <li>Hidden Form Field</li>
            <li>URL Rewriting</li>
            <li>Visitor Counting</li>
        </ul>

    </div>

</div>

</body>
</html>
